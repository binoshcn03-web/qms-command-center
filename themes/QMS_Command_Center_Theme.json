{
  "name": "QMS Command Center",
  "dataColors": [
    "#7B2CBF",
    "#C44B8A",
    "#E07A3D",
    "#5B21B6",
    "#DB2777",
    "#F59E0B",
    "#0F9D58",
    "#2563EB",
    "#0891B2",
    "#64748B"
  ],
  "foreground": "#1B1F24",
  "foregroundNeutralSecondary": "#6B7280",
  "foregroundNeutralTertiary": "#9CA3AF",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F1F8",
  "backgroundNeutral": "#EDE7F6",
  "tableAccent": "#7B2CBF",
  "good": "#0F9D58",
  "neutral": "#F59E0B",
  "bad": "#C62828",
  "maximum": "#7B2CBF",
  "center": "#C44B8A",
  "minimum": "#E07A3D",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B1F24"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B7280"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#EDE7F6" } },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1B1F24" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F4F1F8" } },
            "foregroundColor": { "solid": { "color": "#1B1F24" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F1F8" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#EDE7F6" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#EDE7F6" } },
            "radius": 10
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#1B1F24" } },
            "fontSize": 22,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#6B7280" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#EDE7F6" } },
            "radius": 8
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#6B7280" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#1B1F24" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "plotArea": [
          {
            "transparency": 0
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "plotArea": [
          {
            "transparency": 0
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "plotArea": [
          {
            "transparency": 0
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Bottom"
          }
        ],
        "labels": [
          {
            "show": true,
            "labelStyle": "Percent of total"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#EDE7F6" } },
            "rowPadding": 4,
            "outlineColor": { "solid": { "color": "#EDE7F6" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#7B2CBF" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1B1F24" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1B1F24" } },
            "backColorSecondary": { "solid": { "color": "#F4F1F8" } },
            "fontSize": 9
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#5B21B6" } }
          }
        ]
      }
    }
  }
}
