	measure 'Fatal Coaching SLA %' =
			
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( Fact_Coaching ),
			        Fact_Coaching[IsSlaMet] = TRUE (),
			        Fact_Coaching[IsFatalRelated] = TRUE ()
