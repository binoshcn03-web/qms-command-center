		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b52c608a-d14e-4bcd-8203-98f3f31be8f9

	measure 'Team Quality Score' =
			
			VAR CurrentEmp =
			    MAX ( Dim_Employee[EmployeeID] )
			RETURN
			    IF (
			        ISBLANK ( CurrentEmp ),
			        [Quality Score],
			        CALCULATE (
			            [Quality Score],
			            FILTER (
			                ALL ( Dim_Employee ),
			                PATHCONTAINS ( Dim_Employee[OrgPath], CurrentEmp )
			            )
			        )
			    )
		lineageTag: 92252270-63fa-4d07-8380-caaf94979d29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quality Mean' =
			
			AVERAGE ( Fact_QA_Evaluation[ClientQualityScore] )
		lineageTag: f1c851ba-fe76-4978-849d-d075f4f5e504

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quality Stdev' =
			
			STDEV.P ( Fact_QA_Evaluation[ClientQualityScore] )
		lineageTag: 124c08ff-817e-4cba-b3f8-2354a4bcc8b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'UCL Quality' =
			
			[Quality Mean] + ( 3 * [Quality Stdev] )
		lineageTag: 6b0b4d9c-afed-4c4a-92f7-b400ab3ee718

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LCL Quality' =
			
			MAX ( 0, [Quality Mean] - ( 3 * [Quality Stdev] ) )
		lineageTag: f7cda565-212f-4b15-829f-2ad676613c14

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nelson Rule 1 Points' =
			
			CALCULATE (
			    COUNTROWS ( Fact_QA_Evaluation ),
			    FILTER (
			        Fact_QA_Evaluation,
			        Fact_QA_Evaluation[ClientQualityScore] > [UCL Quality]
			            || Fact_QA_Evaluation[ClientQualityScore] < [LCL Quality]
			    )
			)
		formatString: 0
		lineageTag: a964ea17-4876-4515-ae8f-e06caf4ca024

	measure 'SPC In Control %' =
			
			DIVIDE ( [Audits] - [Nelson Rule 1 Points], [Audits] )
		lineageTag: 1017641a-4745-41ea-bb36-50825159dc03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'COPC Reproducibility Proxy' =
			
			[Calibration Precision %]
		lineageTag: 88e34dee-a448-4600-82ca-e72e3439f9e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quality Slope' =
			
			VAR t =
			    FILTER (
			        SUMMARIZE (
			            Fact_QA_Evaluation,
			            Dim_Date[DateIndex],
			            "Y", AVERAGE ( Fact_QA_Evaluation[ClientQualityScore] )
			        ),
			        NOT ISBLANK ( Dim_Date[DateIndex] )
			    )
			RETURN
			    MINX ( LINESTX ( t, [Y], Dim_Date[DateIndex], TRUE, TRUE ), [Slope1] )
		lineageTag: 7a70aa2a-88c8-46bd-8244-308558ad942e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quality Intercept' =
			
			VAR t =
			    FILTER (
			        SUMMARIZE (
			            Fact_QA_Evaluation,
			            Dim_Date[DateIndex],
			            "Y", AVERAGE ( Fact_QA_Evaluation[ClientQualityScore] )
			        ),
			        NOT ISBLANK ( Dim_Date[DateIndex] )
			    )
			RETURN
			    MINX ( LINESTX ( t, [Y], Dim_Date[DateIndex], TRUE, TRUE ), [Intercept] )
		lineageTag: acb79dc1-77ff-4754-99a9-faf7a2f77b1e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Quality' =
			
			[Quality Intercept] + [Quality Slope] * MAX ( Dim_Date[DateIndex] )
		lineageTag: 82854891-530e-4a19-b11b-f0ecd0be2974

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Occurrence =
			
			MIN ( 10, MAX ( 1, ROUNDUP ( [Attribute Fail Rate] * 10, 0 ) ) )
		lineageTag: 0fce1ac9-9d3f-4246-826b-e3eb779b95af

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure RPN =
			
			[Occurrence]
			    * SELECTEDVALUE ( Dim_QA_Parameter[Severity] )
			    * SELECTEDVALUE ( Dim_QA_Parameter[Detection] )
		lineageTag: 430e7185-19d5-4f97-8ad1-2e61374aff27

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FMEA Rank' =
			
			IF (
			    NOT ISBLANK ( [RPN] ),
			    RANKX ( ALL ( Dim_QA_Parameter[ParameterName] ), [RPN],, DESC, DENSE )
			)
		formatString: 0
		lineageTag: 57ea9caf-70a9-40f6-b1d0-f2633415ec30

	measure 'Defects by Pillar' =
			
			[Defects]
		formatString: 0
		lineageTag: da5c8157-9c8f-4147-bd64-8c30488e60db

	measure 'Pearson Quality vs CSAT' =
			
			VAR t =
			    SUMMARIZE (
			        Fact_QA_Evaluation,
			        Fact_QA_Evaluation[EmployeeID],
			        "Q", AVERAGE ( Fact_QA_Evaluation[ClientQualityScore] ),
			        "C", AVERAGE ( Fact_QA_Evaluation[CsatScore] )
			    )
			VAR n = COUNTROWS ( FILTER ( t, NOT ISBLANK ( [Q] ) && NOT ISBLANK ( [C] ) ) )
			VAR avgq = AVERAGEX ( t, [Q] )
			VAR avgc = AVERAGEX ( t, [C] )
			VAR num =
			    SUMX ( t, ( [Q] - avgq ) * ( [C] - avgc ) )
			VAR den =
			    SQRT ( SUMX ( t, ( [Q] - avgq ) * ( [Q] - avgq ) ) )
			        * SQRT ( SUMX ( t, ( [C] - avgc ) * ( [C] - avgc ) ) )
			RETURN
			    DIVIDE ( num, den )
		lineageTag: 45856b66-f179-40bf-bbf0-74518069640b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Z Score Approx' =
			
			VAR p = [Yield]
			RETURN
			    IF (
			        p <= 0 || p >= 1,
			        BLANK (),
			        4.56 * p ^ 0.25 - 0.86 * ( 1 - p ) ^ 0.25 - 1.85
			    )
		lineageTag: ebe12784-9998-4804-a673-29ccd5bc936b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure RTY =
			
			PRODUCTX (
			    VALUES ( Dim_QA_Parameter[ParameterID] ),
			    VAR y =
			        CALCULATE ( 1 - [Attribute Fail Rate] )
			    RETURN
			        IF ( y <= 0, 0.0001, y )
			)
		lineageTag: 36bf5a35-dae0-4993-9c40-e76a42ddedce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quality Pre Coaching' =
			
			CALCULATE (
			    [Quality Score],
			    DATESINPERIOD ( Dim_Date[FullDate], MIN ( Fact_Coaching[CoachingDatetime] ) - 1, -30, DAY )
			)
		lineageTag: a5e9e3a1-3339-4633-9e02-dca777a3e529

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quality Post Coaching' =
			
			CALCULATE (
			    [Quality Score],
			    DATESINPERIOD ( Dim_Date[FullDate], MAX ( Fact_Coaching[CoachingDatetime] ), 30, DAY )
			)
		lineageTag: 427cb357-5799-4d9c-b27d-8e60b94273e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Coaching Lift' =
			
			[Quality Post Coaching] - [Quality Pre Coaching]
		lineageTag: c6bdd48a-6514-443f-b0b2-74d457c06849

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Coaching ROI Proxy' =
			
			[Coaching Lift] / 100 * [COPQ]
