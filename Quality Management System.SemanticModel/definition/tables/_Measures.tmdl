			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		lineageTag: 20daa567-70b9-4e0e-bc29-af9b95e8de17

	measure Calibrations =
			
			COUNTROWS ( Fact_Calibration )
		formatString: 0
		lineageTag: db70fa76-0ed2-4c8a-aa3e-922e1ea3e43d

	measure 'Calibrations Outside Tolerance' =
			
			SUM ( Fact_Calibration[OutsideFlag] )
		formatString: 0
		lineageTag: 621d450d-6d70-4573-98dd-7e21fef26a46

	measure 'Calibration Precision %' =
			
			DIVIDE (
			    [Calibrations] - [Calibrations Outside Tolerance],
			    [Calibrations]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c26bd4c0-6ae7-4296-b9be-dfeca89e75c9

	measure 'Avg Abs Variance %' =
			
			CALCULATE (
			    AVERAGE ( Fact_Calibration[AbsVariancePct] ),
