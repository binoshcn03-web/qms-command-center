	measure 'Repeat Fail Pairs' =
			
			COUNTROWS (
			    FILTER (
			        ADDCOLUMNS (
			            SUMMARIZE (
			                Fact_QA_Evaluation_Line,
			                Fact_QA_Evaluation_Line[EmployeeID],
			                Fact_QA_Evaluation_Line[ParameterID]
			            ),
			            "@Fails",
			                CALCULATE (
			                    COUNTROWS ( Fact_QA_Evaluation_Line ),
			                    Fact_QA_Evaluation_Line[IsDefect] = TRUE ()
			                )
			        ),
			        [@Fails] >= 2
			    )
			)
		formatString: 0
		lineageTag: 92247a4e-a723-42b9-b386-4b929a2e61b8

	measure 'Repeat Fail Agents' =
			
			COUNTROWS (
			    SUMMARIZE (
			        FILTER (
			            ADDCOLUMNS (
			                SUMMARIZE (
			                    Fact_QA_Evaluation_Line,
			                    Fact_QA_Evaluation_Line[EmployeeID],
			                    Fact_QA_Evaluation_Line[ParameterID]
			                ),
			                "@Fails",
			                    CALCULATE (
			                        COUNTROWS ( Fact_QA_Evaluation_Line ),
			                        Fact_QA_Evaluation_Line[IsDefect] = TRUE ()
			                    )
			            ),
			            [@Fails] >= 2
			        ),
			        Fact_QA_Evaluation_Line[EmployeeID]
			    )
			)
		formatString: 0
		lineageTag: 3d4a0adc-1c04-4be9-b549-fb9ec1285fb0

	measure 'Defect Rank' =
			
			IF (
			    [Defects] > 0,
			    RANKX (
			        ALL ( Dim_QA_Parameter[ParameterName] ),
