	measure 'Glide Target' =
			
			SWITCH (
			    SELECTEDVALUE ( Dim_Employee[TenureBucket] ),
			    "0-30", 70,
			    "31-90", 80,
			    "91-180", 85,
			    ">180", 88,
			    85
			)
		formatString: 0
		lineageTag: 3117f327-50ad-450f-bfe2-9a17d939f942

	measure 'Glide Gap' =
			
			[Quality Score] - [Glide Target]
		lineageTag: 4c600694-ae1e-4ab1-a1b3-05306941b8bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Winsorized Quality Score' =
			
			VAR lo =
			    PERCENTILE.INC ( Fact_QA_Evaluation[ClientQualityScore], 0.1 )
			VAR hi =
			    PERCENTILE.INC ( Fact_QA_Evaluation[ClientQualityScore], 0.9 )
			RETURN
			    AVERAGEX (
			        Fact_QA_Evaluation,
			        MEDIANX (
			            { lo, Fact_QA_Evaluation[ClientQualityScore], hi },
			            [Value]
			        )
			    )
		lineageTag: 03c6221a-8588-4c93-bca1-1fc8517e576b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TCD Mix Selected %' =
			
			DIVIDE (
			    [Contacts],
			    CALCULATE ( [Contacts], ALL ( Dim_TCD ) )
			)
		lineageTag: 1189ae9b-a5a6-40ac-b49a-2689f50fa1e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Defects Previous 30D' =
			
			CALCULATE (
			    [Defects],
			    DATESINPERIOD ( Dim_Date[FullDate], MAX ( Dim_Date[FullDate] ), -30, DAY )
			)
		formatString: 0
		lineageTag: 8948f7c6-3202-4978-b6cc-4170984b0d31

	measure 'Defects Prior 30D' =
			
			CALCULATE (
			    [Defects],
			    DATESINPERIOD ( Dim_Date[FullDate], MAX ( Dim_Date[FullDate] ) - 30, -30, DAY )
			)
		formatString: 0
		lineageTag: 1fcfd981-7a35-4611-90c9-51a7a0b2bfd4

	measure 'Defect Velocity' =
			
			[Defects Previous 30D] - [Defects Prior 30D]
		formatString: 0
		lineageTag: 86ec5a1d-6936-4882-9983-c966d0a371ac

	measure 'TNI Flag' =
			
			IF ( [Defect Velocity] > 0 && [Attribute Fail Rate] > 0.08, "Intervene", "Watch" )
		lineageTag: 44982ad5-24d4-46c0-95e2-e86d7adc65a5

	measure 'Agents Failing Parameter' =
			
			CALCULATE (
			    DISTINCTCOUNT ( Fact_QA_Evaluation_Line[EmployeeID] ),
			    Fact_QA_Evaluation_Line[IsDefect] = TRUE ()
			)
		formatString: 0
		lineageTag: bcbffa9f-18a4-479b-91bb-e2d1068034e7

	measure 'Repeat Fail Type' =
			
			VAR agents = [Agents Failing Parameter]
			VAR pairs = [Repeat Fail Pairs]
			RETURN
			    SWITCH (
			        TRUE (),
			        agents >= 8 && [Attribute Fail Rate] >= 0.12, "Structural",
			        pairs >= 3 && agents <= 3, "Behavioral",
			        pairs >= 2, "Mixed",
			        "None"
			    )
		lineageTag: 01ce830d-ce1c-46a6-ac5f-2f2c6e9adedd

	measure 'Action Sessions' =
			
			COUNTROWS ( Fact_Coaching )
		formatString: 0
		lineageTag: cf3fb1d5-5efc-41eb-9091-8f3bf2434a03

	measure 'Action Lift' =
			
			[Coaching Lift]
		lineageTag: 2d2ec5e3-fb57-4096-9060-ec106fdb300c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Action ROI' =
			
			[Coaching Lift] / 100
			    * CALCULATE ( [COPQ], ALL ( Dim_Coaching ) )
			    * DIVIDE ( [Action Sessions], [Coaching Sessions] )
		lineageTag: 2cff542b-b065-445b-902f-47a46681f3d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PT01 CC Met' = IF ( [CC Accuracy] >= 0.95, 1, 0 )
		formatString: 0
		lineageTag: 1120df6e-d7cb-43d7-98f3-4e6563f7f7b0

	measure 'PT02 BC Met' = IF ( [BC Accuracy] >= 0.90, 1, 0 )
		formatString: 0
		lineageTag: e4b87759-52f0-4ec0-967b-8edb0c068321

	measure 'PT03 CompC Met' = IF ( [CompC Accuracy] >= 0.995, 1, 0 )
		formatString: 0
		lineageTag: dbe28e7d-18a6-4378-a99c-21851d7baf2d

	measure 'PT04 Quality Met' = IF ( [Quality Score] >= 85, 1, 0 )
		formatString: 0
		lineageTag: 770fcb92-4a4a-420b-8d90-360eed5b2c39

	measure 'PT05 Sampling Met' = IF ( [Sampling Attainment %] >= 0.95, 1, 0 )
		formatString: 0
		lineageTag: 26f34b4d-fa02-44fe-8c81-1102c7ccf1c7

	measure 'PT06 Feedback Met' = IF ( [Feedback SLA %] >= 0.90, 1, 0 )
		formatString: 0
		lineageTag: f52a502f-855a-490b-8e06-0e10132fa392

	measure 'PT07 Calibration Met' = IF ( [Calibration Precision %] >= 0.90, 1, 0 )
		formatString: 0
		lineageTag: 8f3685b0-0c4b-44b7-be92-8b4252172722

	measure 'PT08 Fatal Met' = IF ( [Fatal Rate] <= 0.01, 1, 0 )
		formatString: 0
		lineageTag: 9a179af3-7141-44f4-9d86-a03de93ab378

	measure 'PT09 DSAT Met' = IF ( [DSAT Rate] <= 0.12, 1, 0 )
		formatString: 0
		lineageTag: ee4199e6-e7d2-473a-a893-613a5755f28a

	measure 'PT10 Resolve Met' = IF ( [Resolve Rate] >= 0.85, 1, 0 )
		formatString: 0
		lineageTag: 9b2f4597-18ab-4717-81c7-afbbc4474dec

	measure 'PT11 VSF Met' = IF ( [VSF Quality Score] <= 1.5, 1, 0 )
		formatString: 0
		lineageTag: 58dea2f4-fc46-4aa2-99c3-fef56e32e1c5

	measure 'PT12 Repeat Met' = IF ( [Repeat Fail Agents] <= 20, 1, 0 )
		formatString: 0
		lineageTag: 1c10d758-8aa3-4e6d-8fba-026064302746

	measure 'PT13 New Hire Met' = IF ( [New Hire Quality Score] >= 75, 1, 0 )
		formatString: 0
		lineageTag: e0a0089e-1428-41ad-a94b-34ff0d1113f6

	measure 'PT14 GDPR Met' = IF ( [GDPR Defects] = 0, 1, 0 )
		formatString: 0
		lineageTag: 26977d14-0b00-4a61-8e46-914f45d51aa0

	measure 'Control Tower Score' =
			
			[PT01 CC Met] + [PT02 BC Met] + [PT03 CompC Met] + [PT04 Quality Met]
			    + [PT05 Sampling Met] + [PT06 Feedback Met] + [PT07 Calibration Met]
			    + [PT08 Fatal Met] + [PT09 DSAT Met] + [PT10 Resolve Met]
			    + [PT11 VSF Met] + [PT12 Repeat Met] + [PT13 New Hire Met]
			    + [PT14 GDPR Met]
		formatString: 0
		lineageTag: 565121e5-4fe0-4a0e-a4a8-c3709dfec938

	measure 'Control Tower %' =
			
			DIVIDE ( [Control Tower Score], 14 )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b82a715e-b939-4da4-8a89-af40f7a4e719

	measure 'Team Quality Score by Supervisor' =
			
			CALCULATE (
			    [Quality Score],
			    ALL ( Dim_Employee ),
			    Dim_Employee[SupervisorID] = MAX ( Dim_Employee[SupervisorID] )
			)
		lineageTag: 346704fb-6f4c-45de-92bf-355e15bfb186

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quality Score All Sites' =
			
			CALCULATE (
			    [Quality Score],
			    ALL ( Dim_Employee[Site] )
			)
		lineageTag: 5ea1096f-fd0e-480b-859f-a8ba0aa1389b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column1
		dataType: string
		isHidden
		lineageTag: 5711a786-de76-4b8d-84ab-4548d66f9816
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

