	measure 'VSF Quality Score' =
			
			VAR AvgScore =
			    AVERAGE ( Fact_QA_Evaluation[ClientQualityScore] )
			VAR StdScore =
			    STDEV.P ( Fact_QA_Evaluation[ClientQualityScore] )
			RETURN
			    DIVIDE ( 6 * StdScore, AvgScore )
		lineageTag: 6d55391d-a78c-48d9-84dc-c0a925eae68d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

