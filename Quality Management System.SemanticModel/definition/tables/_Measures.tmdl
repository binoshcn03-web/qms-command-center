			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 793aee9f-3659-4bdc-9fd1-49f21b35b4a5

	measure COPQ =
			
			CALCULATE (
			    SUMX (
			        FILTER (
			            Fact_QA_Evaluation_Line,
			            Fact_QA_Evaluation_Line[IsDefect] = TRUE ()
			        ),
			        VAR cls = RELATED ( Dim_QA_Parameter[CopqClassHint] )
			        RETURN
			            LOOKUPVALUE (
			                Dim_COPQ_Rate[TotalUnitCostUsd],
			                Dim_COPQ_Rate[CopqRateKey],
			                cls
			            )
			    ),
			    TREATAS (
			        VALUES ( Fact_QA_Evaluation[Channel] ),
			        Fact_QA_Evaluation_Line[Channel]
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3ae0b68d-7f1b-4bab-9b3c-59201aa4adda

	measure 'COPQ Internal' =
			
			SUMX (
			    FILTER (
			        Fact_QA_Evaluation_Line,
			        Fact_QA_Evaluation_Line[IsDefect] = TRUE ()
			    ),
			    VAR cls = RELATED ( Dim_QA_Parameter[CopqClassHint] )
			    RETURN
			        LOOKUPVALUE (
			            Dim_COPQ_Rate[InternalCostUsd],
			            Dim_COPQ_Rate[CopqRateKey],
			            cls
			        )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 86af09fa-390a-48ef-8037-ff8be257778a

	measure 'COPQ External' =
			
