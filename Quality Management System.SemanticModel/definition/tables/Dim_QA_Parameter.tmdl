	column Severity =
			
			SWITCH (
			    Dim_QA_Parameter[CriticalityType],
			    "Compliance Critical", 10,
			    "Customer Critical", 8,
			    "Business Critical", 5,
			    "Rider", 2,
			    3
			)
		formatString: 0
		lineageTag: cd5f2ce5-b9b2-4cbd-b69c-a2bc576bd583
		summarizeBy: sum

