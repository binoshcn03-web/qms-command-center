	column Detection =
			
			SWITCH (
			    Dim_QA_Parameter[CriticalityType],
			    "Compliance Critical", 3,
			    "Customer Critical", 4,
			    "Business Critical", 6,
			    7
			)
		formatString: 0
		lineageTag: 711c8996-1296-429e-99af-199e045dc978
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Dim_QA_Parameter = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\binos\OneDrive\文档\Data_Analytics_Projects\PBI PI_QMS\Data_Source\Dim_QA_Parameter.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {
				        {"ParameterID", type text}, {"FormVersion", type text}, {"ParameterName", type text},
				        {"Category", type text}, {"CriticalityType", type text}, {"BestQmKpi", type text},
				        {"TargetAccuracyPct", type number}, {"WeightPctClient", Int64.Type}, {"WeightPctInternal", Int64.Type},
				        {"ClientScoreAffecting", type logical}, {"IsCritical", type logical}, {"IsFatal", type logical},
				        {"IsZeroTolerance", type logical}, {"FailInteractionOnFail", type logical},
				        {"IsPrivacySensitive", type logical}, {"IsGdprRelevant", type logical},
				        {"ScoringType", type text}, {"PassThresholdPct", Int64.Type}, {"RepeatFailEligible", type logical},
				        {"IshikawaPillar", type text}, {"CopqClassHint", type text}, {"QualityFocus", type text},
				        {"AmazonFailExample", type text}, {"BestQmNote", type text},
				        {"EffectiveFrom", type date}, {"EffectiveTo", type date},
				        {"IsActive", type logical}, {"SortOrder", Int64.Type}
				    }),
				    Clean = Table.SelectRows(Types, each [ParameterID] <> null and [ParameterID] <> ""),
				    Distinct = Table.Distinct(Clean, {"ParameterID"})
				in
				    Distinct

